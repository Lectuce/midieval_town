[node name="Backsmith" parent="." unique_id=488510564 instance=ExtResource("1_ryrav")]
z_index = 1
position = Vector2(431, -15)
npc_id = "blacksmith"
display_name = "铁匠"
dialogue_lines = Array[String](["欢迎来到铁匠铺！炉火刚旺起来，今天还有不少活要做。", "旁边的手推车装着材料，经过时请给它留点地方。"])

