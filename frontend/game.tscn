[node name="Inkeeper" parent="." unique_id=703076112 instance=ExtResource("1_ryrav")]
z_index = 1
position = Vector2(425, 100)
npc_id = "innkeeper"
display_name = "酒馆老板"
dialogue_lines = Array[String](["欢迎来到酒馆，走累了就歇一会儿吧。", "想了解镇上的消息，可以多和街坊们聊聊。"])

