[node name="Guard2" parent="." unique_id=175042064 instance=ExtResource("1_ryrav")]
z_index = 1
position = Vector2(193, 147)
npc_id = "guard_2"
display_name = "巡逻守卫"
dialogue_lines = Array[String](["我在这里守着城门，镇上的居民可以放心通行。", "平台边缘有矮墙，巡逻时记得留意脚下。"])

[node name="Sprite2D" parent="Guard2" index="0" unique_id=476078173]
